{
  "name": "@fips-app/ds-fips",
  "version": "0.21.0",
  "description": "Design System FIPS: tokens, estilos e componentes React da Ferrovia Interna do Porto de Santos.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FIPS-APP/Design-system-FIPS.git"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "provenance": true
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.config.lib.ts && tsc -p tsconfig.lib.json --emitDeclarationOnly --declaration --outDir dist",
    "build:site": "tsc -b && vite build",
    "test:xlsx": "node --test scripts/xlsx.test.mjs",
    "build:downloads": "bash scripts/build-ai-downloads.sh",
    "lint": "eslint .",
    "test:hero": "node --test scripts/hero-atalho.test.mjs",
    "test": "node --test scripts/contraste.test.mjs",
    "preview": "vite preview",
    "prepublishOnly": "npm test && npm run build && npm run check:pack",
    "check:pack": "node scripts/check-pack.mjs"
  },
  "peerDependencies": {
    "framer-motion": "^11 || ^12",
    "react": "^18.3 || ^19",
    "react-dom": "^18.3 || ^19",
    "tailwindcss": "^4"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.6.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "echarts": "^6.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "framer-motion": "^12.38.0",
    "globals": "^17.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.13.2",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}

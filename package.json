{
  "name": "@fips-app/ds-fips",
  "version": "0.25.5",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./ai/manifest.json": "./ai/manifest.json",
    "./eslint": {
      "types": "./eslint/index.d.ts",
      "default": "./eslint/index.js"
    }
  },
  "bin": {
    "fips-ds": "bin/fips-ds.mjs"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "ai",
    "bin",
    "eslint",
    "README.md",
    "!**/*.map"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.config.lib.ts && tsc -p tsconfig.lib.json --emitDeclarationOnly --declaration --outDir dist && node scripts/gerar-ai.mjs",
    "build:site": "tsc -b && vite build",
    "test:xlsx": "node --test scripts/xlsx.test.mjs",
    "build:downloads": "bash scripts/build-ai-downloads.sh",
    "tokens:gen": "node scripts/gen-tokens-md.mjs",
    "test:badge": "node --test scripts/contraste-badge.test.mjs",
    "lint": "eslint .",
    "test:botao-icone-rotulo": "node --test scripts/botao-icone-rotulo.test.mjs",
    "test:hero": "node --test scripts/hero-atalho.test.mjs",
    "test:select": "node --test scripts/select-portal.test.mjs",
    "test:rolagem": "node --test scripts/rolagem-teclado.test.mjs",
    "test": "node --test scripts/contraste.test.mjs scripts/select-portal.test.mjs scripts/rolagem-teclado.test.mjs scripts/tema.test.mjs scripts/hero-atalho.test.mjs scripts/xlsx.test.mjs scripts/hooks.test.mjs scripts/radio-checkbox.test.mjs scripts/app-shell.test.mjs scripts/formulario-execucao.test.mjs scripts/graficos-documento.test.mjs scripts/listagens.test.mjs scripts/rodada2-medidas.test.mjs scripts/rodada3.test.mjs scripts/fips-ds.test.mjs scripts/eslint-ds.test.mjs scripts/exports-site.test.mjs scripts/app-shell-gaveta.test.mjs scripts/ajustes-celular.test.mjs scripts/contraste-toast.test.mjs scripts/login-seguranca.test.mjs scripts/button-touch.test.mjs scripts/cartoes-conceito.test.mjs scripts/linha-ativa-acoes.test.mjs scripts/botao-icone-rotulo.test.mjs",
    "test:tema": "node --test scripts/tema.test.mjs",
    "test:hooks": "node --test scripts/hooks.test.mjs",
    "test:lint-governanca": "node --test scripts/lint-governanca.test.mjs",
    "test:abas": "node --test scripts/abas-de-secao.test.mjs",
    "test:listagens": "node --test scripts/listagens.test.mjs",
    "test:casca": "node --test scripts/app-shell.test.mjs",
    "test:gaveta": "node --test scripts/app-shell-gaveta.test.mjs",
    "test:rodada3": "node --test scripts/rodada3.test.mjs",
    "test:exports": "node --test scripts/exports-site.test.mjs",
    "test:celular": "node --test scripts/ajustes-celular.test.mjs",
    "preview": "vite preview",
    "test:fips-ds": "node --test scripts/fips-ds.test.mjs"
  },
  "peerDependencies": {
    "framer-motion": ">=11",
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=4"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "echarts": "^6.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "framer-motion": "^12.38.0",
    "globals": "^17.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.13.2",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  },
  "engines": {
    "node": ">=22"
  }
}

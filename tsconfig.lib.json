{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "noEmit": false,
    "rootDir": "src"
  },
  // Só o que o entry alcança: o tsc segue os imports a partir daqui. Com
  // "include": ["src"] saíam .d.ts de docs, hooks e composites não exportados.
  "files": ["src/index.ts"],
  "include": []
}
